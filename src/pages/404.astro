---
import Layout from "~/layouts/Layout.astro";
---

<Layout page="Page introuvable" description="Cette page n'existe pas.">
  <div class="flex flex-col items-center space-y-6 p-4 text-center text-zinc-200">
    <h1 class="text-3xl font-bold text-emerald-400 md:text-4xl">Page introuvable</h1>
    <p>La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a
      href="/"
      class="text-emerald-400 underline underline-offset-4 transition-all duration-300 hover:brightness-150"
    >
      Retour à l'accueil
    </a>
  </div>
</Layout>
