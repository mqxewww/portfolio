---
import { Image } from "astro:assets";
import Layout from "~layouts/Layout.astro";
---

<Layout
  page="Accueil"
  description="Portfolio de Maxence NOIZET, étudiant en sciences informatiques."
>
  <div class="flex flex-col items-center p-4 pt-12 md:flex-row md:justify-between md:p-8">
    <div
      class="flex max-w-2xl flex-col items-center space-y-6 text-center text-zinc-200 md:items-start md:text-left"
    >
      <div class="space-y-2">
        <p class="text-lg font-semibold md:text-2xl">
          Bonjour
          <span class="inline-block origin-bottom animate-[wave_3s_infinite] text-xl md:text-3xl">
            👋
          </span>
        </p>
        <p class="text-2xl font-bold md:text-4xl">
          Je m'appelle <span class="text-emerald-400">Maxence</span>.
        </p>
      </div>
      <div class="space-y-3 text-sm leading-relaxed md:text-lg">
        <p>
          Étudiant 🇫🇷 de 23 ans en Master 1 de Sciences Informatiques, je suis passionné par le
          développement d'applications et les nouvelles technologies.
        </p>
        <p>Parcourez mon portfolio pour en savoir plus sur moi.</p>
      </div>
    </div>

    <div class="mt-6 md:mt-0 md:ml-8">
      <Image
        width={400}
        height={400}
        src="https://avatars.githubusercontent.com/u/89202276"
        alt="github-profile"
        class="mx-auto size-50 rounded-full border-4 border-emerald-400 shadow-lg md:size-100"
        loading="eager"
      />
    </div>
  </div>
</Layout>

<style>
  @keyframes wave {
    0% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(14deg);
    }
    30% {
      transform: rotate(-8deg);
    }
    45% {
      transform: rotate(14deg);
    }
    60% {
      transform: rotate(-4deg);
    }
    75% {
      transform: rotate(10deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }
</style>
