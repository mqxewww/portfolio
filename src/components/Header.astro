---
import { Image } from "astro:assets";
import icon from "~assets/icon.png";
import { ariaCurrent } from "~/utils.ts";
---

<header class="fixed top-0 right-0 left-0 z-50 w-full">
  <div class="relative m-4 flex items-center justify-center space-x-4 text-sm">
    <Image
      width="40"
      height="40"
      src={icon}
      alt="icon"
      class="absolute rounded-full"
      loading="eager"
    />
    <div
      class="flex space-x-16 rounded-2xl bg-gray-700 bg-linear-to-tl from-zinc-700 to-zinc-600 px-8 py-2 lg:space-x-20 lg:px-12"
    >
      <a
        class="font-medium text-zinc-400 text-shadow-lg aria-[current=page]:text-emerald-200"
        href="/"
        aria-current={ariaCurrent("/", Astro.url.pathname)}
      >
        <p>ACCUEIL</p>
      </a>
      <a
        class="font-medium text-zinc-400 text-shadow-lg aria-[current=page]:text-emerald-200"
        href="/about"
        aria-current={ariaCurrent("/about", Astro.url.pathname)}
      >
        <p>À PROPOS</p>
      </a>
    </div>
  </div>
</header>
