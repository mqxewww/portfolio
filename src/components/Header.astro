---
import { Image } from "astro:assets";
import icon from "~/assets/icon.png";
import { ariaCurrent } from "~/utils.ts";

const links = [
  { href: "/", label: "ACCUEIL" },
  { href: "/about", label: "À PROPOS" },
];
---

<header class="fixed top-0 right-0 left-0 z-50 w-full">
  <div class="relative m-4 flex items-center justify-center space-x-4 text-sm">
    <Image
      width="40"
      height="40"
      layout="none"
      src={icon}
      alt=""
      class="absolute rounded-full"
      loading="eager"
    />
    <nav class="flex space-x-16 rounded-2xl bg-linear-to-tl from-zinc-700 to-zinc-600 px-8 py-2 lg:space-x-20 lg:px-12">
      {links.map(({ href, label }) => (
        <a
          class="font-medium text-zinc-400 text-shadow-lg aria-[current=page]:text-emerald-200"
          href={href}
          aria-current={ariaCurrent(href, Astro.url.pathname)}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
