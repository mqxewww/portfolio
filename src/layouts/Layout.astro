---
import { ClientRouter } from "astro:transitions";
import Footer from "~components/Footer.astro";
import Header from "~components/Header.astro";
import "~styles/global.css";

interface Props {
  page: string;
  description: string;
}

const { page, description } = Astro.props;

const title = `${page} | Portfolio`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="canonical" href={`https://mqxewww.dev${Astro.url.pathname}`} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-192x192.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://mqxewww.dev${Astro.url.pathname}`} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:image"
      content="https://raw.githubusercontent.com/mqxewww/portfolio/refs/heads/main/src/assets/icon.png"
    />
    <meta property="og:site_name" content="mqxewww.dev" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mqxewww" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://raw.githubusercontent.com/mqxewww/portfolio/refs/heads/main/src/assets/icon.png"
    />

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-900 bg-linear-to-tl from-zinc-900 to-zinc-800">
    <Header />
    <main class="flex w-full flex-1 items-center justify-center">
      <slot />
    </main>
    <Footer />
  </body>
</html>
